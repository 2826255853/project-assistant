{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "allow-projects-add-from-picker",
    "allow-project-get",
    "allow-project-git-summary",
    "allow-projects-list",
    "allow-project-open-directory",
    "allow-project-open-file",
    "allow-project-pick-file",
    "allow-project-remove",
    "allow-project-select",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-get-all-windows",
    "core:window:allow-is-visible",
    "allow-app-get-status",
    "allow-settings-get",
    "allow-settings-update",
    "allow-project-settings-update",
    "allow-session-create",
    "allow-session-find-by-request",
    "allow-sessions-list",
    "allow-session-get",
    "allow-session-resume",
    "allow-session-end",
    "allow-task-start",
    "allow-task-find-by-request",
    "allow-tasks-list",
    "allow-task-get",
    "allow-task-cancel",
    "allow-task-events-get",
    "allow-approvals-get",
    "allow-logs-get-status",
    "allow-logs-clear",
    "allow-providers-list",
    "allow-provider-save",
    "allow-provider-set-enabled",
    "allow-provider-delete",
    "allow-provider-models",
    "allow-provider-test",
    "allow-provider-switch",
    "allow-operation-get",
    "allow-operation-cancel",
    "allow-credential-put",
    "allow-credential-remove",
    "allow-desktop-initialize",
    "allow-overlay-get",
    "allow-overlay-control",
    "core:window:allow-close"
  ]
}
