{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Project Assistant",
  "version": "0.1.0",
  "identifier": "com.origami.project-assistant",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Project Assistant",
        "width": 1180,
        "height": 760,
        "minWidth": 780,
        "minHeight": 560
      }
    ],
    "security": {
      "capabilities": ["default", "overlay"],
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
