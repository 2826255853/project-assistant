{
  "name": "project-assistant",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "verify:desktop": "node scripts/verify-desktop.mjs",
    "verify:shell": "node scripts/verify-shell.mjs",
    "verify:state": "node scripts/verify-state.mjs",
    "verify:settings": "node scripts/verify-settings.mjs",
    "verify:logging": "node scripts/verify-logging.mjs",
    "verify:credentials": "node scripts/verify-credentials.mjs",
    "verify:isolation": "node scripts/verify-isolation.mjs",
    "verify:git": "node scripts/verify-git.mjs",
    "verify:system-open": "node scripts/verify-system-open.mjs",
    "verify:storage": "node scripts/verify-storage.mjs",
    "test:ipc": "node --test scripts/ipc/*.test.mjs",
    "verify:ipc": "node scripts/verify-ipc.mjs",
    "verify:codex": "node scripts/verify-codex.mjs",
    "verify:codex:providers": "node scripts/verify-codex-providers.mjs",
    "inspect:cc-switch": "node scripts/inspect-cc-switch.mjs",
